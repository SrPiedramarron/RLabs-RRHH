use HandlesAuthorization;

public function before(User $user, string $ability): bool|null
{
    if ($user->hasRole('super_admin')) {
        return true;
    }
    return null;
}<?php

namespace App\Policies;

use App\Models\User;
use App\Models\ComisionUpload;
use Illuminate\Auth\Access\HandlesAuthorization;

class ComisionUploadPolicy
{
    use HandlesAuthorization;

    /**
     * Determine whether the user can view any models.
     */
    public function viewAny(User $user): bool
    {
        return $user->can('view_any_comision::upload');
    }

    /**
     * Determine whether the user can view the model.
     */
    public function view(User $user, ComisionUpload $comisionUpload): bool
    {
        return $user->can('view_comision::upload');
    }

    /**
     * Determine whether the user can create models.
     */
    public function create(User $user): bool
    {
        return $user->can('create_comision::upload');
    }

    /**
     * Determine whether the user can update the model.
     */
    public function update(User $user, ComisionUpload $comisionUpload): bool
    {
        return $user->can('update_comision::upload');
    }

    /**
     * Determine whether the user can delete the model.
     */
    public function delete(User $user, ComisionUpload $comisionUpload): bool
    {
        return $user->can('delete_comision::upload');
    }

    /**
     * Determine whether the user can bulk delete.
     */
    public function deleteAny(User $user): bool
    {
        return $user->can('delete_any_comision::upload');
    }

    /**
     * Determine whether the user can permanently delete.
     */
    public function forceDelete(User $user, ComisionUpload $comisionUpload): bool
    {
        return $user->can('force_delete_comision::upload');
    }

    /**
     * Determine whether the user can permanently bulk delete.
     */
    public function forceDeleteAny(User $user): bool
    {
        return $user->can('force_delete_any_comision::upload');
    }

    /**
     * Determine whether the user can restore.
     */
    public function restore(User $user, ComisionUpload $comisionUpload): bool
    {
        return $user->can('restore_comision::upload');
    }

    /**
     * Determine whether the user can bulk restore.
     */
    public function restoreAny(User $user): bool
    {
        return $user->can('restore_any_comision::upload');
    }

    /**
     * Determine whether the user can replicate.
     */
    public function replicate(User $user, ComisionUpload $comisionUpload): bool
    {
        return $user->can('replicate_comision::upload');
    }

    /**
     * Determine whether the user can reorder.
     */
    public function reorder(User $user): bool
    {
        return $user->can('reorder_comision::upload');
    }
public function detalle(User $user, ComisionUpload $record): bool
{
    return $user->can('view_comision::upload');
}

}
